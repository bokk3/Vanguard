; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Vanguard"
config/version="0.8.6"
run/main_scene="res://home_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.015, 0.025, 0.045, 1)
boot_splash/image="res://ui/project_vanguard_title.png"
boot_splash/minimum_display_time=1000

[audio]

busses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

AuthManager="*res://auth_manager.gd"
Updater="*res://updater.gd"
ConfigManager="*res://config_manager.gd"
SaveManager="*res://save_manager.gd"
MissionManager="*res://mission_manager.gd"
NetworkManager="*res://network_manager.gd"
NetworkControllerServer="*res://network_controller_server.gd"

[dotnet]

project/assembly_name="Project Vanguard"

[rendering]

textures/vram_compression/import_etc2_astc=true
